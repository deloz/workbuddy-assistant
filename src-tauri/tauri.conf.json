{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy助手",
  "version": "../package.json",
  "identifier": "com.workbuddy.assistant",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://localhost:31847",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy助手",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": null
    }
  }
}
